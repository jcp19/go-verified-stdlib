// Enables Gobra in the current file.
// +gobra

// This file holds lemmas about package container/list that are useful to
// clients of the package.

package list

// DistinctLists proves that two lists whose memory predicates are held
// separately are distinct. This fact is hidden inside the (folded)
// predicates, so clients that call a method of one list with an element or
// mark of another need this lemma to discharge the mode dispatch of the
// contract.
ghost
preserves a.Mem()
preserves b.Mem()
ensures   a != b && a != nil && b != nil
ensures   a.Es() == old(a.Es()) && a.Vs() == old(a.Vs()) && a.IsInit() == old(a.IsInit())
ensures   b.Es() == old(b.Es()) && b.Vs() == old(b.Vs()) && b.IsInit() == old(b.IsInit())
decreases
func DistinctLists(a, b *List) {
	unfold a.Mem()
	unfold b.Mem()
	assert a != b
	fold a.Mem()
	fold b.Mem()
}
