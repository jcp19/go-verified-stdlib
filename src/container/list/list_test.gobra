// Enables Gobra in the current file.
// +gobra

// This file is the Gobra translation of list_test.go. Each test function
// mirrors the corresponding Go test; calls into the testing framework are
// replaced by assert statements, and the ghost arguments track the
// abstraction (the sequences of elements and values) of every list.

package list

preserves l.Mem(ges, vs, ini)
requires  len(ges) == len(vs)
requires  n == len(ges)
ensures   res
decreases
func checkListLen(l *List, n int, ghost ges seq[*Element], ghost vs seq[any], ghost ini bool) (res bool) {
	if v := l.Len(ges, vs, ini); v != n {
		assert false // t.Errorf("l.Len() = %d, want %d", n, len)
		return false
	}
	return true
}

preserves acc(es)
preserves l.Mem(ges, vs, true)
requires  len(ges) == len(vs)
requires  len(es) == len(ges)
requires  forall k int :: {&es[k]} 0 <= k && k < len(es) ==> es[k] == ges[k]
decreases
func checkListPointers(l *List, es []*Element, ghost ges seq[*Element], ghost vs seq[any]) {
	root := &l.root

	if !checkListLen(l, len(es), ges, vs, true) {
		return
	}

	// zero length lists must be the zero value or properly initialized (sentinel circle)
	if len(es) == 0 {
		unfold l.Mem(ges, vs, true)
		if l.root.next != nil && l.root.next != root || l.root.prev != nil && l.root.prev != root {
			assert false // t.Errorf("l.root.next = %p, l.root.prev = %p; both should both be nil or %p", ...)
		}
		fold l.Mem(ges, vs, true)
		return
	}
	// len(es) > 0

	// check internal and external prev/next connections
	invariant 0 <= i && i <= len(es)
	invariant acc(es)
	invariant l.Mem(ges, vs, true)
	invariant len(es) == len(ges)
	invariant forall k int :: {&es[k]} 0 <= k && k < len(es) ==> es[k] == ges[k]
	decreases len(es) - i
	for i := 0; i < len(es); i += 1 {
		e := es[i]
		prev := root
		var Prev *Element = nil
		if i > 0 {
			prev = es[i-1]
			Prev = prev
		}
		unfold l.Mem(ges, vs, true)
		assert ges[i] == e
		assert i > 0 ==> ges[i].prev == ges[i-1]
		assert i == 0 ==> ges[i].prev == root
		if p := e.prev; p != prev {
			assert false // t.Errorf("elt[%d](%p).prev = %p, want %p", ...)
		}
		fold l.Mem(ges, vs, true)
		if p := e.Prev(l, ges, vs, i); p != Prev {
			assert false // t.Errorf("elt[%d](%p).Prev() = %p, want %p", ...)
		}

		next := root
		var Next *Element = nil
		if i < len(es)-1 {
			next = es[i+1]
			Next = next
		}
		unfold l.Mem(ges, vs, true)
		assert i < len(es)-1 ==> ges[i].next == ges[i+1]
		assert i == len(es)-1 ==> ges[i].next == root
		if n := e.next; n != next {
			assert false // t.Errorf("elt[%d](%p).next = %p, want %p", ...)
		}
		fold l.Mem(ges, vs, true)
		if n := e.Next(l, ges, vs, i); n != Next {
			assert false // t.Errorf("elt[%d](%p).Next() = %p, want %p", ...)
		}
	}
}

func TestList() {
	l := New()
	checkListPointers(l, []*Element{}, seq[*Element]{}, seq[any]{})

	// Single element list
	e := l.PushFront("a", seq[*Element]{}, seq[any]{}, true)
	checkListPointers(l, []*Element{e}, seq[*Element]{e}, seq[any]{"a"})
	l.MoveToFront(e, l, seq[*Element]{e}, seq[any]{"a"}, seq[*Element]{}, seq[any]{}, 0, true)
	checkListPointers(l, []*Element{e}, seq[*Element]{e}, seq[any]{"a"})
	l.MoveToBack(e, l, seq[*Element]{e}, seq[any]{"a"}, seq[*Element]{}, seq[any]{}, 0, true)
	checkListPointers(l, []*Element{e}, seq[*Element]{e}, seq[any]{"a"})
	l.Remove(e, l, seq[*Element]{e}, seq[any]{"a"}, seq[*Element]{}, seq[any]{}, 0, true)
	checkListPointers(l, []*Element{}, seq[*Element]{}, seq[any]{})

	// Bigger list
	e2 := l.PushFront(int(2), seq[*Element]{}, seq[any]{}, true)
	e1 := l.PushFront(int(1), seq[*Element]{e2}, seq[any]{int(2)}, true)
	e3 := l.PushBack(int(3), seq[*Element]{e1, e2}, seq[any]{int(1), int(2)}, true)
	e4 := l.PushBack(string("banana"), seq[*Element]{e1, e2, e3}, seq[any]{int(1), int(2), int(3)}, true)
	checkListPointers(l, []*Element{e1, e2, e3, e4}, seq[*Element]{e1, e2, e3, e4}, seq[any]{int(1), int(2), int(3), string("banana")})

	testListMoves(l, e1, e2, e3, e4)
}

// testListMoves is the continuation of TestList; the test is split into a
// few functions to keep the verification time of each part manageable.
requires l != nil
requires l.Mem(seq[*Element]{e1, e2, e3, e4}, seq[any]{int(1), int(2), int(3), string("banana")}, true)
decreases
func testListMoves(l *List, e1, e2, e3, e4 *Element) {
	l.Remove(e2, l, seq[*Element]{e1, e2, e3, e4}, seq[any]{int(1), int(2), int(3), string("banana")}, seq[*Element]{}, seq[any]{}, 1, true)
	checkListPointers(l, []*Element{e1, e3, e4}, seq[*Element]{e1, e3, e4}, seq[any]{int(1), int(3), string("banana")})

	l.MoveToFront(e3, l, seq[*Element]{e1, e3, e4}, seq[any]{int(1), int(3), string("banana")}, seq[*Element]{}, seq[any]{}, 1, true) // move from middle
	checkListPointers(l, []*Element{e3, e1, e4}, seq[*Element]{e3, e1, e4}, seq[any]{int(3), int(1), string("banana")})

	l.MoveToFront(e1, l, seq[*Element]{e3, e1, e4}, seq[any]{int(3), int(1), string("banana")}, seq[*Element]{}, seq[any]{}, 1, true)
	l.MoveToBack(e3, l, seq[*Element]{e1, e3, e4}, seq[any]{int(1), int(3), string("banana")}, seq[*Element]{}, seq[any]{}, 1, true) // move from middle
	checkListPointers(l, []*Element{e1, e4, e3}, seq[*Element]{e1, e4, e3}, seq[any]{int(1), string("banana"), int(3)})

	l.MoveToFront(e3, l, seq[*Element]{e1, e4, e3}, seq[any]{int(1), string("banana"), int(3)}, seq[*Element]{}, seq[any]{}, 2, true) // move from back
	checkListPointers(l, []*Element{e3, e1, e4}, seq[*Element]{e3, e1, e4}, seq[any]{int(3), int(1), string("banana")})
	l.MoveToFront(e3, l, seq[*Element]{e3, e1, e4}, seq[any]{int(3), int(1), string("banana")}, seq[*Element]{}, seq[any]{}, 0, true) // should be no-op
	checkListPointers(l, []*Element{e3, e1, e4}, seq[*Element]{e3, e1, e4}, seq[any]{int(3), int(1), string("banana")})

	l.MoveToBack(e3, l, seq[*Element]{e3, e1, e4}, seq[any]{int(3), int(1), string("banana")}, seq[*Element]{}, seq[any]{}, 0, true) // move from front
	checkListPointers(l, []*Element{e1, e4, e3}, seq[*Element]{e1, e4, e3}, seq[any]{int(1), string("banana"), int(3)})
	l.MoveToBack(e3, l, seq[*Element]{e1, e4, e3}, seq[any]{int(1), string("banana"), int(3)}, seq[*Element]{}, seq[any]{}, 2, true) // should be no-op
	checkListPointers(l, []*Element{e1, e4, e3}, seq[*Element]{e1, e4, e3}, seq[any]{int(1), string("banana"), int(3)})

	testListInsertBefore(l, e1, e3, e4)
}

// testListInsertBefore is the continuation of TestList.
requires l != nil
requires l.Mem(seq[*Element]{e1, e4, e3}, seq[any]{int(1), string("banana"), int(3)}, true)
decreases
func testListInsertBefore(l *List, e1, e3, e4 *Element) {
	e2 := l.InsertBefore(int(2), e1, l, seq[*Element]{e1, e4, e3}, seq[any]{int(1), string("banana"), int(3)}, seq[*Element]{}, seq[any]{}, 0, true) // insert before front
	checkListPointers(l, []*Element{e2, e1, e4, e3}, seq[*Element]{e2, e1, e4, e3}, seq[any]{int(2), int(1), string("banana"), int(3)})
	l.Remove(e2, l, seq[*Element]{e2, e1, e4, e3}, seq[any]{int(2), int(1), string("banana"), int(3)}, seq[*Element]{}, seq[any]{}, 0, true)
	e2 = l.InsertBefore(int(2), e4, l, seq[*Element]{e1, e4, e3}, seq[any]{int(1), string("banana"), int(3)}, seq[*Element]{}, seq[any]{}, 1, true) // insert before middle
	checkListPointers(l, []*Element{e1, e2, e4, e3}, seq[*Element]{e1, e2, e4, e3}, seq[any]{int(1), int(2), string("banana"), int(3)})
	l.Remove(e2, l, seq[*Element]{e1, e2, e4, e3}, seq[any]{int(1), int(2), string("banana"), int(3)}, seq[*Element]{}, seq[any]{}, 1, true)
	e2 = l.InsertBefore(int(2), e3, l, seq[*Element]{e1, e4, e3}, seq[any]{int(1), string("banana"), int(3)}, seq[*Element]{}, seq[any]{}, 2, true) // insert before back
	checkListPointers(l, []*Element{e1, e4, e2, e3}, seq[*Element]{e1, e4, e2, e3}, seq[any]{int(1), string("banana"), int(2), int(3)})
	l.Remove(e2, l, seq[*Element]{e1, e4, e2, e3}, seq[any]{int(1), string("banana"), int(2), int(3)}, seq[*Element]{}, seq[any]{}, 2, true)

	testListInsertAfter(l, e1, e3, e4)
}

// testListInsertAfter is the continuation of TestList.
requires l != nil
requires l.Mem(seq[*Element]{e1, e4, e3}, seq[any]{int(1), string("banana"), int(3)}, true)
decreases
func testListInsertAfter(l *List, e1, e3, e4 *Element) {
	e2 := l.InsertAfter(int(2), e1, l, seq[*Element]{e1, e4, e3}, seq[any]{int(1), string("banana"), int(3)}, seq[*Element]{}, seq[any]{}, 0, true) // insert after front
	checkListPointers(l, []*Element{e1, e2, e4, e3}, seq[*Element]{e1, e2, e4, e3}, seq[any]{int(1), int(2), string("banana"), int(3)})
	l.Remove(e2, l, seq[*Element]{e1, e2, e4, e3}, seq[any]{int(1), int(2), string("banana"), int(3)}, seq[*Element]{}, seq[any]{}, 1, true)
	e2 = l.InsertAfter(int(2), e4, l, seq[*Element]{e1, e4, e3}, seq[any]{int(1), string("banana"), int(3)}, seq[*Element]{}, seq[any]{}, 1, true) // insert after middle
	checkListPointers(l, []*Element{e1, e4, e2, e3}, seq[*Element]{e1, e4, e2, e3}, seq[any]{int(1), string("banana"), int(2), int(3)})
	l.Remove(e2, l, seq[*Element]{e1, e4, e2, e3}, seq[any]{int(1), string("banana"), int(2), int(3)}, seq[*Element]{}, seq[any]{}, 2, true)
	e2 = l.InsertAfter(int(2), e3, l, seq[*Element]{e1, e4, e3}, seq[any]{int(1), string("banana"), int(3)}, seq[*Element]{}, seq[any]{}, 2, true) // insert after back
	checkListPointers(l, []*Element{e1, e4, e3, e2}, seq[*Element]{e1, e4, e3, e2}, seq[any]{int(1), string("banana"), int(3), int(2)})
	l.Remove(e2, l, seq[*Element]{e1, e4, e3, e2}, seq[any]{int(1), string("banana"), int(3), int(2)}, seq[*Element]{}, seq[any]{}, 3, true)

	testListIterate(l, e1, e3, e4)
}

// testListIterate is the continuation of TestList.
requires l != nil
requires l.Mem(seq[*Element]{e1, e4, e3}, seq[any]{int(1), string("banana"), int(3)}, true)
decreases
func testListIterate(l *List, e1, e3, e4 *Element) {
	// Check standard iteration.
	sum := 0
	ghost var k int = 0
	invariant 0 <= k && k <= 3
	invariant l.Mem(seq[*Element]{e1, e4, e3}, seq[any]{int(1), string("banana"), int(3)}, true)
	invariant k < 3 ==> e5 == seq[*Element]{e1, e4, e3}[k] && e5 != nil
	invariant k == 3 ==> e5 == nil
	invariant sum == (k == 0 ? 0 : (k == 3 ? 4 : 1))
	decreases 3 - k
	for e5 := l.Front(seq[*Element]{e1, e4, e3}, seq[any]{int(1), string("banana"), int(3)}, true); e5 != nil; e5 = e5.Next(l, seq[*Element]{e1, e4, e3}, seq[any]{int(1), string("banana"), int(3)}, k-1) {
		unfold l.Mem(seq[*Element]{e1, e4, e3}, seq[any]{int(1), string("banana"), int(3)}, true)
		assert k == 0 ==> e5 == e1 && e5.Value === int(1)
		assert k == 1 ==> e5 == e4 && e5.Value === string("banana")
		assert k == 2 ==> e5 == e3 && e5.Value === int(3)
		assert k == 0 ==> typeOf(e5.Value) == type[int]
		assert k == 2 ==> typeOf(e5.Value) == type[int]
		if i, ok := e5.Value.(int); ok {
			sum += i
		}
		fold l.Mem(seq[*Element]{e1, e4, e3}, seq[any]{int(1), string("banana"), int(3)}, true)
		k = k + 1
	}
	if sum != 4 {
		assert false // t.Errorf("sum over l = %d, want 4", sum)
	}

	// Clear all elements by iterating
	ghost var es0 seq[*Element] = seq[*Element]{e1, e4, e3}
	ghost var vs0 seq[any] = seq[any]{int(1), string("banana"), int(3)}
	var next *Element
	ghost var k2 int = 0
	invariant 0 <= k2 && k2 <= 3
	invariant l.Mem(es0[k2:], vs0[k2:], true)
	invariant k2 < 3 ==> e6 == es0[k2] && e6 != nil
	invariant k2 == 3 ==> e6 == nil
	decreases 3 - k2
	for e6 := l.Front(es0, vs0, true); e6 != nil; e6 = next {
		assert (es0[k2:])[0] == es0[k2]
		next = e6.Next(l, es0[k2:], vs0[k2:], 0)
		l.Remove(e6, l, es0[k2:], vs0[k2:], seq[*Element]{}, seq[any]{}, 0, true)
		assert (es0[k2:])[1:] == es0[k2+1:] && (vs0[k2:])[1:] == vs0[k2+1:]
		k2 = k2 + 1
	}
	checkListPointers(l, []*Element{}, seq[*Element]{}, seq[any]{})
}

preserves acc(es)
preserves l.Mem(ges, vs, true)
requires  len(ges) == len(vs)
requires  len(es) == len(ges)
requires  forall k int :: {&es[k]} 0 <= k && k < len(es) ==> es[k] === vs[k]
decreases
func checkList(l *List, es []any, ghost ges seq[*Element], ghost vs seq[any]) {
	if !checkListLen(l, len(es), ges, vs, true) {
		return
	}

	i := 0
	invariant 0 <= i && i <= len(ges)
	invariant acc(es)
	invariant len(es) == len(ges)
	invariant forall k int :: {&es[k]} 0 <= k && k < len(es) ==> es[k] === vs[k]
	invariant l.Mem(ges, vs, true)
	invariant i < len(ges) ==> e == ges[i] && e != nil
	invariant i == len(ges) ==> e == nil
	decreases len(ges) - i
	for e := l.Front(ges, vs, true); e != nil; e = e.Next(l, ges, vs, i-1) {
		unfold l.Mem(ges, vs, true)
		le := e.Value
		fold l.Mem(ges, vs, true)
		assert le === es[i] // le != es[i] would make the original test call t.Errorf
		i += 1
	}
}

func TestExtending() {
	l1 := New()
	l2 := New()

	a1 := l1.PushBack(1, seq[*Element]{}, seq[any]{}, true)
	a2 := l1.PushBack(2, seq[*Element]{a1}, seq[any]{1}, true)
	a3 := l1.PushBack(3, seq[*Element]{a1, a2}, seq[any]{1, 2}, true)

	b1 := l2.PushBack(4, seq[*Element]{}, seq[any]{}, true)
	b2 := l2.PushBack(5, seq[*Element]{b1}, seq[any]{4}, true)

	testExtendingBack(l1, l2, a1, a2, a3, b1, b2)
}

// testExtendingBack is the continuation of TestExtending; the test is split
// into a few functions to keep the verification time of each part manageable.
requires l1 != nil && l2 != nil
requires l1.Mem(seq[*Element]{a1, a2, a3}, seq[any]{1, 2, 3}, true)
requires l2.Mem(seq[*Element]{b1, b2}, seq[any]{4, 5}, true)
decreases
func testExtendingBack(l1, l2 *List, a1, a2, a3, b1, b2 *Element) {
	ghost var es1 seq[*Element] = seq[*Element]{a1, a2, a3}
	ghost var vs1 seq[any] = seq[any]{1, 2, 3}
	ghost var es2 seq[*Element] = seq[*Element]{b1, b2}
	ghost var vs2 seq[any] = seq[any]{4, 5}

	l3 := New()
	DistinctLists(l3, l1, seq[*Element]{}, seq[any]{}, true, true, es1, vs1)
	n1 := l3.PushBackList(l1, seq[*Element]{}, seq[any]{}, es1, vs1, true, true)
	checkList(l3, []any{1, 2, 3}, seq[*Element]{} ++ n1, seq[any]{} ++ vs1)
	DistinctLists(l3, l2, seq[*Element]{} ++ n1, seq[any]{} ++ vs1, true, true, es2, vs2)
	n2 := l3.PushBackList(l2, seq[*Element]{} ++ n1, seq[any]{} ++ vs1, es2, vs2, true, true)
	checkList(l3, []any{1, 2, 3, 4, 5}, (seq[*Element]{} ++ n1) ++ n2, (seq[any]{} ++ vs1) ++ vs2)

	testExtendingFront(l1, l2, a1, a2, a3, b1, b2)
}

// testExtendingFront is the continuation of TestExtending.
requires l1 != nil && l2 != nil
requires l1.Mem(seq[*Element]{a1, a2, a3}, seq[any]{1, 2, 3}, true)
requires l2.Mem(seq[*Element]{b1, b2}, seq[any]{4, 5}, true)
decreases
func testExtendingFront(l1, l2 *List, a1, a2, a3, b1, b2 *Element) {
	ghost var es1 seq[*Element] = seq[*Element]{a1, a2, a3}
	ghost var vs1 seq[any] = seq[any]{1, 2, 3}
	ghost var es2 seq[*Element] = seq[*Element]{b1, b2}
	ghost var vs2 seq[any] = seq[any]{4, 5}

	l3 := New()
	DistinctLists(l3, l2, seq[*Element]{}, seq[any]{}, true, true, es2, vs2)
	n3 := l3.PushFrontList(l2, seq[*Element]{}, seq[any]{}, es2, vs2, true, true)
	checkList(l3, []any{4, 5}, n3 ++ seq[*Element]{}, vs2 ++ seq[any]{})
	DistinctLists(l3, l1, n3 ++ seq[*Element]{}, vs2 ++ seq[any]{}, true, true, es1, vs1)
	n4 := l3.PushFrontList(l1, n3 ++ seq[*Element]{}, vs2 ++ seq[any]{}, es1, vs1, true, true)
	checkList(l3, []any{1, 2, 3, 4, 5}, n4 ++ (n3 ++ seq[*Element]{}), vs1 ++ (vs2 ++ seq[any]{}))

	checkList(l1, []any{1, 2, 3}, es1, vs1)
	checkList(l2, []any{4, 5}, es2, vs2)

	testExtendingSelfBack(l1, l2, a1, a2, a3, b1, b2)
}

// testExtendingSelfBack is the continuation of TestExtending.
requires l1 != nil && l2 != nil
requires l1.Mem(seq[*Element]{a1, a2, a3}, seq[any]{1, 2, 3}, true)
requires l2.Mem(seq[*Element]{b1, b2}, seq[any]{4, 5}, true)
decreases
func testExtendingSelfBack(l1, l2 *List, a1, a2, a3, b1, b2 *Element) {
	ghost var es1 seq[*Element] = seq[*Element]{a1, a2, a3}
	ghost var vs1 seq[any] = seq[any]{1, 2, 3}

	l3 := New()
	DistinctLists(l3, l1, seq[*Element]{}, seq[any]{}, true, true, es1, vs1)
	n5 := l3.PushBackList(l1, seq[*Element]{}, seq[any]{}, es1, vs1, true, true)
	checkList(l3, []any{1, 2, 3}, seq[*Element]{} ++ n5, seq[any]{} ++ vs1)
	n6 := l3.PushBackList(l3, seq[*Element]{} ++ n5, seq[any]{} ++ vs1, seq[*Element]{} ++ n5, seq[any]{} ++ vs1, true, true)
	checkList(l3, []any{1, 2, 3, 1, 2, 3}, (seq[*Element]{} ++ n5) ++ n6, (seq[any]{} ++ vs1) ++ (seq[any]{} ++ vs1))

	testExtendingSelfFront(l1, l2, a1, a2, a3, b1, b2)
}

// testExtendingSelfFront is the continuation of TestExtending.
requires l1 != nil && l2 != nil
requires l1.Mem(seq[*Element]{a1, a2, a3}, seq[any]{1, 2, 3}, true)
requires l2.Mem(seq[*Element]{b1, b2}, seq[any]{4, 5}, true)
decreases
func testExtendingSelfFront(l1, l2 *List, a1, a2, a3, b1, b2 *Element) {
	ghost var es1 seq[*Element] = seq[*Element]{a1, a2, a3}
	ghost var vs1 seq[any] = seq[any]{1, 2, 3}

	l3 := New()
	DistinctLists(l3, l1, seq[*Element]{}, seq[any]{}, true, true, es1, vs1)
	n7 := l3.PushFrontList(l1, seq[*Element]{}, seq[any]{}, es1, vs1, true, true)
	checkList(l3, []any{1, 2, 3}, n7 ++ seq[*Element]{}, vs1 ++ seq[any]{})
	n8 := l3.PushFrontList(l3, n7 ++ seq[*Element]{}, vs1 ++ seq[any]{}, n7 ++ seq[*Element]{}, vs1 ++ seq[any]{}, true, true)
	checkList(l3, []any{1, 2, 3, 1, 2, 3}, n8 ++ (n7 ++ seq[*Element]{}), (vs1 ++ seq[any]{}) ++ (vs1 ++ seq[any]{}))

	l3 = New()
	DistinctLists(l1, l3, es1, vs1, true, true, seq[*Element]{}, seq[any]{})
	n9 := l1.PushBackList(l3, es1, vs1, seq[*Element]{}, seq[any]{}, true, true)
	checkList(l1, []any{1, 2, 3}, es1 ++ n9, vs1 ++ seq[any]{})
	DistinctLists(l1, l3, es1 ++ n9, vs1 ++ seq[any]{}, true, true, seq[*Element]{}, seq[any]{})
	n10 := l1.PushFrontList(l3, es1 ++ n9, vs1 ++ seq[any]{}, seq[*Element]{}, seq[any]{}, true, true)
	checkList(l1, []any{1, 2, 3}, n10 ++ (es1 ++ n9), seq[any]{} ++ (vs1 ++ seq[any]{}))
}

func TestRemove() {
	l := New()
	e1 := l.PushBack(1, seq[*Element]{}, seq[any]{}, true)
	e2 := l.PushBack(2, seq[*Element]{e1}, seq[any]{1}, true)
	checkListPointers(l, []*Element{e1, e2}, seq[*Element]{e1, e2}, seq[any]{1, 2})
	e := l.Front(seq[*Element]{e1, e2}, seq[any]{1, 2}, true)
	l.Remove(e, l, seq[*Element]{e1, e2}, seq[any]{1, 2}, seq[*Element]{}, seq[any]{}, 0, true)
	checkListPointers(l, []*Element{e2}, seq[*Element]{e2}, seq[any]{2})
	l.Remove(e, nil, seq[*Element]{e2}, seq[any]{2}, seq[*Element]{}, seq[any]{}, 0, true)
	checkListPointers(l, []*Element{e2}, seq[*Element]{e2}, seq[any]{2})
}

func TestIssue4103() {
	l1 := New()
	c1 := l1.PushBack(1, seq[*Element]{}, seq[any]{}, true)
	c2 := l1.PushBack(2, seq[*Element]{c1}, seq[any]{1}, true)

	l2 := New()
	d1 := l2.PushBack(3, seq[*Element]{}, seq[any]{}, true)
	d2 := l2.PushBack(4, seq[*Element]{d1}, seq[any]{3}, true)

	e := l1.Front(seq[*Element]{c1, c2}, seq[any]{1, 2}, true)
	DistinctLists(l1, l2, seq[*Element]{c1, c2}, seq[any]{1, 2}, true, true, seq[*Element]{d1, d2}, seq[any]{3, 4})
	l2.Remove(e, l1, seq[*Element]{d1, d2}, seq[any]{3, 4}, seq[*Element]{c1, c2}, seq[any]{1, 2}, 0, true) // l2 should not change because e is not an element of l2
	if n := l2.Len(seq[*Element]{d1, d2}, seq[any]{3, 4}, true); n != 2 {
		assert false // t.Errorf("l2.Len() = %d, want 2", n)
	}

	w := l1.InsertBefore(8, e, l1, seq[*Element]{c1, c2}, seq[any]{1, 2}, seq[*Element]{}, seq[any]{}, 0, true)
	if n := l1.Len(seq[*Element]{w, c1, c2}, seq[any]{8, 1, 2}, true); n != 3 {
		assert false // t.Errorf("l1.Len() = %d, want 3", n)
	}
}

func TestIssue6349() {
	l := New()
	s1 := l.PushBack(1, seq[*Element]{}, seq[any]{}, true)
	s2 := l.PushBack(2, seq[*Element]{s1}, seq[any]{1}, true)

	e := l.Front(seq[*Element]{s1, s2}, seq[any]{1, 2}, true)
	l.Remove(e, l, seq[*Element]{s1, s2}, seq[any]{1, 2}, seq[*Element]{}, seq[any]{}, 0, true)
	assert e.Value === 1 // e.Value != 1 would make the original test call t.Errorf
	if e.Next(nil, seq[*Element]{}, seq[any]{}, 0) != nil {
		assert false // t.Errorf("e.Next() != nil")
	}
	if e.Prev(nil, seq[*Element]{}, seq[any]{}, 0) != nil {
		assert false // t.Errorf("e.Prev() != nil")
	}
}

func TestMove() {
	l := New()
	e1 := l.PushBack(1, seq[*Element]{}, seq[any]{}, true)
	e2 := l.PushBack(2, seq[*Element]{e1}, seq[any]{1}, true)
	e3 := l.PushBack(3, seq[*Element]{e1, e2}, seq[any]{1, 2}, true)
	e4 := l.PushBack(4, seq[*Element]{e1, e2, e3}, seq[any]{1, 2, 3}, true)

	l.MoveAfter(e3, e3, l, seq[*Element]{e1, e2, e3, e4}, seq[any]{1, 2, 3, 4}, seq[*Element]{}, seq[any]{}, 2, 2, true)
	checkListPointers(l, []*Element{e1, e2, e3, e4}, seq[*Element]{e1, e2, e3, e4}, seq[any]{1, 2, 3, 4})
	l.MoveBefore(e2, e2, l, seq[*Element]{e1, e2, e3, e4}, seq[any]{1, 2, 3, 4}, seq[*Element]{}, seq[any]{}, 1, 1, true)
	checkListPointers(l, []*Element{e1, e2, e3, e4}, seq[*Element]{e1, e2, e3, e4}, seq[any]{1, 2, 3, 4})

	l.MoveAfter(e3, e2, l, seq[*Element]{e1, e2, e3, e4}, seq[any]{1, 2, 3, 4}, seq[*Element]{}, seq[any]{}, 2, 1, true)
	checkListPointers(l, []*Element{e1, e2, e3, e4}, seq[*Element]{e1, e2, e3, e4}, seq[any]{1, 2, 3, 4})
	l.MoveBefore(e2, e3, l, seq[*Element]{e1, e2, e3, e4}, seq[any]{1, 2, 3, 4}, seq[*Element]{}, seq[any]{}, 1, 2, true)
	checkListPointers(l, []*Element{e1, e2, e3, e4}, seq[*Element]{e1, e2, e3, e4}, seq[any]{1, 2, 3, 4})

	l.MoveBefore(e2, e4, l, seq[*Element]{e1, e2, e3, e4}, seq[any]{1, 2, 3, 4}, seq[*Element]{}, seq[any]{}, 1, 3, true)
	checkListPointers(l, []*Element{e1, e3, e2, e4}, seq[*Element]{e1, e3, e2, e4}, seq[any]{1, 3, 2, 4})
	tmp1 := e2
	e2 = e3
	e3 = tmp1

	// After the renaming, the value stored in an element travels with it,
	// so the value sequences below follow the elements, not the positions.
	l.MoveBefore(e4, e1, l, seq[*Element]{e1, e2, e3, e4}, seq[any]{1, 3, 2, 4}, seq[*Element]{}, seq[any]{}, 3, 0, true)
	checkListPointers(l, []*Element{e4, e1, e2, e3}, seq[*Element]{e4, e1, e2, e3}, seq[any]{4, 1, 3, 2})
	tmp2 := e4
	e4 = e3
	e3 = e2
	e2 = e1
	e1 = tmp2

	l.MoveAfter(e4, e1, l, seq[*Element]{e1, e2, e3, e4}, seq[any]{4, 1, 3, 2}, seq[*Element]{}, seq[any]{}, 3, 0, true)
	checkListPointers(l, []*Element{e1, e4, e2, e3}, seq[*Element]{e1, e4, e2, e3}, seq[any]{4, 2, 1, 3})
	tmp3 := e4
	e4 = e3
	e3 = e2
	e2 = tmp3

	l.MoveAfter(e2, e3, l, seq[*Element]{e1, e2, e3, e4}, seq[any]{4, 2, 1, 3}, seq[*Element]{}, seq[any]{}, 1, 2, true)
	checkListPointers(l, []*Element{e1, e3, e2, e4}, seq[*Element]{e1, e3, e2, e4}, seq[any]{4, 1, 2, 3})
}

// Test PushFront, PushBack, PushFrontList, PushBackList with uninitialized List
func TestZeroList() {
	l1 := new(List)
	fold l1.Mem(seq[*Element]{}, seq[any]{}, false)
	z1 := l1.PushFront(1, seq[*Element]{}, seq[any]{}, false)
	checkList(l1, []any{1}, seq[*Element]{z1}, seq[any]{1})

	l2 := new(List)
	fold l2.Mem(seq[*Element]{}, seq[any]{}, false)
	z2 := l2.PushBack(1, seq[*Element]{}, seq[any]{}, false)
	checkList(l2, []any{1}, seq[*Element]{z2}, seq[any]{1})

	l3 := new(List)
	fold l3.Mem(seq[*Element]{}, seq[any]{}, false)
	DistinctLists(l3, l1, seq[*Element]{}, seq[any]{}, false, true, seq[*Element]{z1}, seq[any]{1})
	n3 := l3.PushFrontList(l1, seq[*Element]{}, seq[any]{}, seq[*Element]{z1}, seq[any]{1}, false, true)
	checkList(l3, []any{1}, n3 ++ seq[*Element]{}, seq[any]{1} ++ seq[any]{})

	l4 := new(List)
	fold l4.Mem(seq[*Element]{}, seq[any]{}, false)
	DistinctLists(l4, l2, seq[*Element]{}, seq[any]{}, false, true, seq[*Element]{z2}, seq[any]{1})
	n4 := l4.PushBackList(l2, seq[*Element]{}, seq[any]{}, seq[*Element]{z2}, seq[any]{1}, false, true)
	checkList(l4, []any{1}, seq[*Element]{} ++ n4, seq[any]{} ++ seq[any]{1})
}

// Test that a list l is not modified when calling InsertBefore with a mark that is not an element of l.
func TestInsertBeforeUnknownMark() {
	var l@ List
	fold l.Mem(seq[*Element]{}, seq[any]{}, false)
	m1 := l.PushBack(1, seq[*Element]{}, seq[any]{}, false)
	m2 := l.PushBack(2, seq[*Element]{m1}, seq[any]{1}, true)
	m3 := l.PushBack(3, seq[*Element]{m1, m2}, seq[any]{1, 2}, true)
	l.InsertBefore(1, new(Element), nil, seq[*Element]{m1, m2, m3}, seq[any]{1, 2, 3}, seq[*Element]{}, seq[any]{}, 0, true)
	checkList(&l, []any{1, 2, 3}, seq[*Element]{m1, m2, m3}, seq[any]{1, 2, 3})
}

// Test that a list l is not modified when calling InsertAfter with a mark that is not an element of l.
func TestInsertAfterUnknownMark() {
	var l@ List
	fold l.Mem(seq[*Element]{}, seq[any]{}, false)
	m1 := l.PushBack(1, seq[*Element]{}, seq[any]{}, false)
	m2 := l.PushBack(2, seq[*Element]{m1}, seq[any]{1}, true)
	m3 := l.PushBack(3, seq[*Element]{m1, m2}, seq[any]{1, 2}, true)
	l.InsertAfter(1, new(Element), nil, seq[*Element]{m1, m2, m3}, seq[any]{1, 2, 3}, seq[*Element]{}, seq[any]{}, 0, true)
	checkList(&l, []any{1, 2, 3}, seq[*Element]{m1, m2, m3}, seq[any]{1, 2, 3})
}

// Test that a list l is not modified when calling MoveAfter or MoveBefore with a mark that is not an element of l.
func TestMoveUnknownMark() {
	var l1@ List
	fold l1.Mem(seq[*Element]{}, seq[any]{}, false)
	e1 := l1.PushBack(1, seq[*Element]{}, seq[any]{}, false)

	var l2@ List
	fold l2.Mem(seq[*Element]{}, seq[any]{}, false)
	e2 := l2.PushBack(2, seq[*Element]{}, seq[any]{}, false)

	DistinctLists(&l1, &l2, seq[*Element]{e1}, seq[any]{1}, true, true, seq[*Element]{e2}, seq[any]{2})
	l1.MoveAfter(e1, e2, &l2, seq[*Element]{e1}, seq[any]{1}, seq[*Element]{e2}, seq[any]{2}, 0, 0, true)
	checkList(&l1, []any{1}, seq[*Element]{e1}, seq[any]{1})
	checkList(&l2, []any{2}, seq[*Element]{e2}, seq[any]{2})

	l1.MoveBefore(e1, e2, &l2, seq[*Element]{e1}, seq[any]{1}, seq[*Element]{e2}, seq[any]{2}, 0, 0, true)
	checkList(&l1, []any{1}, seq[*Element]{e1}, seq[any]{1})
	checkList(&l2, []any{2}, seq[*Element]{e2}, seq[any]{2})
}
