// Enables Gobra in the current file.
// +gobra

// This file holds the Gobra specification of package container/ring:
// the memory predicate, the ghost functions the contracts are written in
// terms of, and the closure specification used by Do.
//
// A ring is a circular doubly-linked list without a header: every element is
// an equally good handle on the whole ring. The abstraction is therefore not
// carried in ghost fields of a distinguished node (as in container/list) but
// passed explicitly:
//
//	Mem(rs, vs)  owns the elements rs of one ring, in forward order, and
//	             states that vs are the values they store (vs[i] is the value
//	             of rs[i]).
//
// Because the abstraction is a parameter rather than a ghost field, Mem(rs,
// vs) is one resource shared by every handle on the ring, and a method says
// which handle it was called on with a ghost index i satisfying rs[i] == r.
// Two pointers into the same ring -- as in the package's own TestUnlink --
// therefore need no lemma to move the abstraction between them, and a method
// that leaves the ring alone needs no "nothing changed" postcondition, since
// rs and vs are pinned in the predicate's own arguments. Do is the one
// exception: it reports the values in the order it visits them, so it asks for
// rs[0] == r.

package ring

// ElemSet is the set of elements of rs. Mem keys ownership by this set rather
// than by position, as container/list does: a footprint keyed by position has
// to be re-derived whenever the sequence is cut or spliced, while one keyed by
// the set is split and merged by set algebra alone. That is what makes Link's
// same-ring case -- which cuts one ring into two -- provable at all.
//
// The pointwise membership travels as a postcondition, so that Mem's body,
// which cannot call a lemma, still gets permission for rs[i]. ElemSet is
// opaque: it is recursive and appears in Mem's body, so leaving it transparent
// would unroll it at every unfold. The lemmas reveal it where they induct on
// it.
ghost
ensures   forall k int :: {rs[k]} 0 <= k && k < len(rs) ==> rs[k] elem res
ensures   len(rs) == 0 ==> res == set[*Ring]{}
decreases len(rs)
opaque
pure func ElemSet(rs seq[*Ring]) (res set[*Ring]) {
	return len(rs) == 0 ? set[*Ring]{} :
		(set[*Ring]{rs[0]} union ElemSet(rs[1:]))
}

// Mem(rs, vs) owns one ring: the elements rs, in forward order, storing the
// values vs.
//
// The zero value of Ring is documented as "a one-element ring with a nil
// Value", so a single element whose next and prev are still nil is a ring of
// length one here. Every exported method initializes such an element on its
// first use (the r.next == nil branches in ring.go), which is why the
// contracts below can promise IsInit on the way out but must not demand it on
// the way in.
pred Mem(rs seq[*Ring], vs seq[any]) {
	0 < len(rs) &&
	len(rs) == len(vs) &&
	// The elements are distinct, stated as a cardinality: it has no quantifier
	// at all, where the pairwise form is instantiated once per pair of rs[.]
	// terms at every unfold. LemmaDistinct unpacks it where it is needed.
	len(ElemSet(rs)) == len(rs) &&
	(forall i int :: {rs[i]} 0 <= i && i < len(rs) ==> rs[i] elem ElemSet(rs)) &&
	// Ownership, one quantified permission per field, each triggered on that
	// field and keyed by the element set. Per field rather than acc(p): Ring
	// has an interface-typed field, and a quantified acc(p) over such a struct
	// is what defeated the cut in the first place (see gobra-status.md).
	(forall p *Ring :: {p.next} p elem ElemSet(rs) ==> acc(&p.next)) &&
	(forall p *Ring :: {p.prev} p elem ElemSet(rs) ==> acc(&p.prev)) &&
	(forall p *Ring :: {p.Value} p elem ElemSet(rs) ==> acc(&p.Value)) &&
	(forall i int :: {rs[i]} 0 <= i && i < len(rs) ==> rs[i] != nil && rs[i].Value === vs[i]) &&
	// Consecutive elements are linked, one quantifier per direction, triggered
	// on the field read: naming rs[i+1] does not create rs[i+1].next, so the
	// body cannot re-trigger itself.
	(forall i int :: {rs[i].next} 0 <= i && i < len(rs)-1 ==> rs[i].next == rs[i+1]) &&
	(forall i int :: {rs[i].prev} 0 < i && i < len(rs) ==> rs[i].prev == rs[i-1]) &&
	// A ring that has not been initialized yet is a single element linked to
	// nothing; any other ring is closed. For len(rs) > 1 the linkage above
	// already forces rs[0].next == rs[1] != nil, so only a one-element ring
	// can take the first branch.
	(rs[0].next == nil ==> len(rs) == 1 && rs[0].prev == nil) &&
	(rs[0].next != nil ==> rs[len(rs)-1].next == rs[0] && rs[0].prev == rs[len(rs)-1])
}

// IsInit reports whether the ring rs has been linked up, i.e. whether it is
// anything other than a single element still holding the zero value's nil
// next and prev. It is an implementation detail rather than part of the
// abstraction -- every exported operation behaves the same either way -- but
// the package's own tests read r.next and r.prev directly, so it has to be
// observable.
ghost
requires  Mem(rs, vs)
decreases
pure func IsInit(rs seq[*Ring], vs seq[any]) bool {
	return unfolding Mem(rs, vs) in rs[0].next != nil
}

// Size is the number of elements of the ring rs. Its postcondition exports the
// shape invariants of Mem -- a ring is never empty, and it stores one value per
// element -- which are otherwise sealed inside the folded predicate. A contract
// that mentions rs and vs together is not well-formed without them.
ghost
requires  Mem(rs, vs)
ensures   0 < res && res == len(rs) && res == len(vs)
decreases
pure func Size(rs seq[*Ring], vs seq[any]) (res int) {
	return unfolding Mem(rs, vs) in len(rs)
}

// Wrap normalizes the position k of a ring of m elements to [0, m). It is the
// "% r.Len()" of the doc comments of Move and Unlink, taken as a position: the
// Euclidean remainder, so that a negative k counts backwards from the end.
//
// It applies Go's % to non-negative dividends only, which is what the
// periodicity lemmas in lemmas.gobra need. The previous form,
// ((k % m) + m) % m, denotes the same function but applies % to negative
// dividends, and on Z3 >= 4.14 the solver can no longer relate (k+m) % m to
// k % m there (see the note above wrapShift).
ghost
requires  0 < m
ensures   0 <= res && res < m
decreases
pure func Wrap(k int, m int) (res int) {
	return k >= 0 ? k % m : (m-1) - ((-k-1) % m)
}

// step is Wrap phrased as n single steps around a ring of m elements, which is
// how Move actually walks. Move's loop invariant is stated with step and
// stepIsWrap (lemmas.gobra) bridges it to the closed form used in the contract.
// It is package-internal: no exported contract mentions it.
ghost
requires  0 < m && 0 <= i && i < m
ensures   0 <= res && res < m
decreases n < 0 ? -n : n
pure func step(i int, n int, m int) (res int) {
	return n == 0 ? i :
		(n > 0 ? step(i+1 == m ? 0 : i+1, n-1, m) :
			step(i == 0 ? m-1 : i-1, n+1, m))
}

// Visitor is the ghost counterpart of the function a client passes to Do.
// Seen(calls) is the client's invariant after f has been applied to exactly
// the values calls, in that order; Accepts(v) is the client's precondition on
// a single value, which lets partial functions -- such as the summing closure
// of ring_test.go, which asserts p.(int) -- be passed to Do.
type Visitor interface {
	pred Seen(ghost calls seq[any])

	ghost
	decreases
	pure Accepts(v any) bool
}

// VisitSpec is the closure specification of the function passed to Do: one
// call extends the sequence of values already seen by the value it is given.
ghost
requires  vis != nil && vis.Seen(prev) && vis.Accepts(v)
ensures   vis.Seen(prev ++ seq[any]{v})
decreases
func VisitSpec(ghost vis Visitor, ghost prev seq[any], v any)
