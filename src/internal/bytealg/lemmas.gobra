// Enables Gobra in the current file.
// +gobra

// This file holds the lemmas of package bytealg: ghost functions whose only
// purpose is to establish a fact about the abstractions defined in
// spec.gobra. They carry no permissions and are erased at compile time.
//
// Lemmas live here rather than in spec.gobra so that the specification -- the
// definitions a reader must understand to read the contracts -- stays separate
// from the proofs that discharge them.

package bytealg

import "arith"

// lemmaMatchesAtRangeFromPointwise: pointwise equality of the window with the
// pattern establishes MatchesAtRange. The trigger pat[m] contains no
// arithmetic, so it is a valid SMT pattern (unlike q[j+m]).
ghost
requires  0 <= j && 0 <= k && k <= len(pat) && j+k <= len(q)
requires  forall m int :: {pat[m]} 0 <= m && m < k ==> q[j+m] == pat[m]
ensures   MatchesAtRange(q, pat, j, k)
decreases k
func lemmaMatchesAtRangeFromPointwise(q, pat seq[byte], j, k int) {
	if k > 0 {
		lemmaMatchesAtRangeFromPointwise(q, pat, j, k-1)
		assert reveal MatchesAtRange(q, pat, j, k)
	}
}

// lemmaMatchesAtRangePointwise: the converse, used to refute a match from a
// single mismatching position.
ghost
requires  0 <= j && 0 <= k && k <= len(pat) && j+k <= len(q)
requires  MatchesAtRange(q, pat, j, k)
ensures   forall m int :: {pat[m]} 0 <= m && m < k ==> q[j+m] == pat[m]
decreases k
func lemmaMatchesAtRangePointwise(q, pat seq[byte], j, k int) {
	if k > 0 {
		assert reveal MatchesAtRange(q, pat, j, k)
		lemmaMatchesAtRangePointwise(q, pat, j, k-1)
	}
}

// lemmaNoMatchBeforeZero: the empty prefix trivially contains no match.
ghost
requires  len(pat) <= len(q)+1
ensures   NoMatchBefore(q, pat, 0)
decreases
func lemmaNoMatchBeforeZero(q, pat seq[byte]) {
	assert reveal NoMatchBefore(q, pat, 0)
}

// LemmaNoMatchBeforePointwise lets clients turn NoMatchBefore into the
// pointwise form.
ghost
requires  0 <= hi && hi-1+len(pat) <= len(q)
requires  NoMatchBefore(q, pat, hi)
ensures   forall j int :: {MatchesAt(q, pat, j)} 0 <= j && j < hi ==> !MatchesAt(q, pat, j)
decreases hi
func LemmaNoMatchBeforePointwise(q, pat seq[byte], hi int) {
	if hi > 0 {
		assert reveal NoMatchBefore(q, pat, hi)
		LemmaNoMatchBeforePointwise(q, pat, hi-1)
	}
}

// This package is verified with --disableNL (see ../../gobra/arith), so the
// solver does nothing with a product of two non-constants -- not even replace
// equals by equals under it. Every non-linear step below is therefore an
// explicit appeal to package arith, and every one of these wrappers has the
// same two-part shape: instantiate the arith lemma, then bridge between
// arith.Pow and PowRK, which are equal by PowRK's definition but are distinct
// monomials to the arithmetic solver.
//
// Products by PrimeRK need no such care: PrimeRK is a numeral, so scaling by
// it stays linear.

// lemmaMulSubstFirst is congruence for a product, which is not free under
// --disableNL: a caller that knows pow == PowRK(PrimeRK, n) still has to ask
// for pow*x == PowRK(PrimeRK, n)*x.
ghost
requires  x == y
ensures   x*z == y*z
decreases
func lemmaMulSubstFirst(x, y, z uint32) { arith.MulSubstFirst(x, y, z) }

// lemmaPowRKOneMul: PrimeRK^0 * x == x. The empty-range base case of the
// DropFirst lemmas below bottoms out in this.
//
// The exponent is a parameter constrained to be zero rather than the literal
// 0, and lemmaPowRKMulStep below names both e and e+1, so that instantiating
// them produces the caller's own product terms. Under --disableNL a product
// is opaque, and a conclusion about PrimeRK^0 * x is of no use to a caller
// holding PrimeRK^(hi-lo-1) * x even though the exponents are equal.
ghost
requires  e == 0
ensures   PowRK(PrimeRK, e)*x == x
decreases
func lemmaPowRKOneMul(x uint32, e int) {
	arith.MulOneAt(PowRK(PrimeRK, e), PrimeRK, x)
}

// lemmaPowRKHornerStep is one step of Horner's rule with the weight of the
// leading term moved up one power: given h, the hash of a range, and r, the
// hash of that range without its leading byte x, it gives the hash of the
// range extended by one byte y, with x's weight raised from PrimeRK^e to
// PrimeRK^f. It is the single non-linear step of the whole Rabin-Karp
// development, and the shape both DropFirst lemmas and both roll lemmas need.
//
// Every operand is a parameter, so instantiating it yields the caller's own
// terms and leaves nothing to rearrange; see arith.PowHornerStep for why that
// matters under --disableNL.
ghost
requires  0 <= e && f == e+1
requires  h == PowRK(PrimeRK, e)*x + r
ensures   h*PrimeRK + y == PowRK(PrimeRK, f)*x + (r*PrimeRK + y)
decreases
func lemmaPowRKHornerStep(x, r, y, h uint32, e, f int) {
	arith.PowHornerStep(PowRK(PrimeRK, e), PowRK(PrimeRK, f), PrimeRK, x, r, y, h, e)
}

// The three lemmas below are the exponentiation-by-squaring loops of
// bytealg.go, which compute PrimeRK^len(sep) by halving the exponent while
// squaring the base. Their invariant is PowRKMul(pow, sq, i), not the product
// pow*PowRK(sq, i) the code computes: under --disableNL the solver does no
// congruence reasoning under a product at all, so an invariant written as a
// product cannot be carried across the loop's own assignments to pow and sq.
// As one function application it is an ordinary term and the step is plain
// congruence. See arith.MulPow.

// lemmaPowRKMulStart: at the start pow is 1 and the invariant is the target.
ghost
requires  0 <= e
ensures   PowRKMul(1, b, e) == PowRK(b, e)
decreases
func lemmaPowRKMulStart(b uint32, e int) { arith.MulPowStart(b, e) }

// lemmaPowRKMulEnd: at the end the exponent is zero and the invariant is pow.
ghost
ensures   PowRKMul(a, b, 0) == a
decreases
func lemmaPowRKMulEnd(a, b uint32) { arith.MulPowEnd(a, b) }

// lemmaPowRKMulStep: one step -- halve the exponent, square the base, and fold
// the odd bit into the factor.
ghost
requires  0 <= i && j == i/2 && bb == b*b
requires  i%2 == 0 ==> a2 == a
requires  i%2 != 0 ==> a2 == a*b
ensures   PowRKMul(a, b, i) == PowRKMul(a2, bb, j)
decreases
func lemmaPowRKMulStep(a, a2, b, bb uint32, i, j int) {
	arith.MulPowStep(a, a2, b, bb, i, j)
}

// The four hash abstractions are opaque (see spec.gobra): callers see their
// contracts, not their bodies. Their base cases are exposed as postconditions,
// but a proof that walks a range one byte at a time also needs the recursive
// step, and `reveal` is only available where the definition is in scope. The
// four lemmas below hand that single unfolding step to clients -- notably the
// hashing loops of bytealg.go, whose bodies extend the range by one byte.
//
// Making these functions opaque is what makes this package tractable at all:
// with their definitions visible, Z3 instantiates them all over the Rabin-Karp
// proofs and the package takes about twenty minutes; behind `opaque` plus the
// step lemmas below it takes seconds.

// lemmaRKHashRangeStep unfolds RKHashRange once at its upper end.
ghost
requires  0 <= lo && lo < hi && hi <= len(q)
ensures   RKHashRange(q, lo, hi) == RKHashRange(q, lo, hi-1)*PrimeRK + uint32(q[hi-1])
decreases
func lemmaRKHashRangeStep(q seq[byte], lo, hi int) {
	assert reveal RKHashRange(q, lo, hi) == RKHashRange(q, lo, hi-1)*PrimeRK + uint32(q[hi-1])
}

// lemmaRKHashRevRangeStep unfolds RKHashRevRange once at its lower end.
ghost
requires  0 <= lo && lo < hi && hi <= len(q)
ensures   RKHashRevRange(q, lo, hi) == RKHashRevRange(q, lo+1, hi)*PrimeRK + uint32(q[lo])
decreases
func lemmaRKHashRevRangeStep(q seq[byte], lo, hi int) {
	assert reveal RKHashRevRange(q, lo, hi) == RKHashRevRange(q, lo+1, hi)*PrimeRK + uint32(q[lo])
}

// lemmaRKHashStrStep unfolds RKHashStr once at its upper end.
ghost
requires  0 <= lo && lo < hi && hi <= len(s)
ensures   RKHashStr(s, lo, hi) == RKHashStr(s, lo, hi-1)*PrimeRK + uint32(s[hi-1])
decreases
func lemmaRKHashStrStep(s string, lo, hi int) {
	assert reveal RKHashStr(s, lo, hi) == RKHashStr(s, lo, hi-1)*PrimeRK + uint32(s[hi-1])
}

// lemmaRKHashStrRevStep unfolds RKHashStrRev once at its lower end.
ghost
requires  0 <= lo && lo < hi && hi <= len(s)
ensures   RKHashStrRev(s, lo, hi) == RKHashStrRev(s, lo+1, hi)*PrimeRK + uint32(s[lo])
decreases
func lemmaRKHashStrRevStep(s string, lo, hi int) {
	assert reveal RKHashStrRev(s, lo, hi) == RKHashStrRev(s, lo+1, hi)*PrimeRK + uint32(s[lo])
}

// lemmaRKHashRangeDropFirst peels the first byte off a range hash:
//   RKHashRange(q, lo, hi) == q[lo]*PrimeRK^(hi-lo-1) + RKHashRange(q, lo+1, hi).
ghost
requires  0 <= lo && lo < hi && hi <= len(q)
ensures   RKHashRange(q, lo, hi) == PowRK(PrimeRK, hi-lo-1)*uint32(q[lo]) + RKHashRange(q, lo+1, hi)
decreases hi - lo
func lemmaRKHashRangeDropFirst(q seq[byte], lo, hi int) {
	lemmaRKHashRangeStep(q, lo, hi)
	if lo+1 == hi {
		lemmaPowRKOneMul(uint32(q[lo]), hi-lo-1)
	} else {
		lemmaRKHashRangeDropFirst(q, lo, hi-1)
		lemmaRKHashRangeStep(q, lo+1, hi)
		lemmaPowRKHornerStep(uint32(q[lo]), RKHashRange(q, lo+1, hi-1), uint32(q[hi-1]), RKHashRange(q, lo, hi-1), hi-lo-2, hi-lo-1)
	}
}

// lemmaRKHashRangeRoll is the rolling-hash update step of Rabin-Karp: sliding
// the window q[i-n:i] one position to the right multiplies the hash by
// PrimeRK, adds the new last byte, and removes the contribution
// PrimeRK^n * q[i-n] of the dropped byte.
ghost
requires  0 < n && n <= i && i < len(q)
ensures   RKHashRange(q, i-n+1, i+1) == RKHashRange(q, i-n, i)*PrimeRK + uint32(q[i]) - PowRK(PrimeRK, n)*uint32(q[i-n])
decreases
func lemmaRKHashRangeRoll(q seq[byte], n, i int) {
	lemmaRKHashRangeDropFirst(q, i-n, i)
	lemmaRKHashRangeStep(q, i-n+1, i+1)
	lemmaPowRKHornerStep(uint32(q[i-n]), RKHashRange(q, i-n+1, i), uint32(q[i]), RKHashRange(q, i-n, i), n-1, n)
}

// lemmaRKHashRangePointwise: ranges that agree pointwise hash equally.
ghost
requires  0 <= j && 0 <= m && m <= len(pat) && j+m <= len(q)
requires  forall k int :: {q[j+k]} {pat[k]} 0 <= k && k < m ==> q[j+k] == pat[k]
ensures   RKHashRange(q, j, j+m) == RKHashRange(pat, 0, m)
decreases m
func lemmaRKHashRangePointwise(q, pat seq[byte], j, m int) {
	if m > 0 {
		lemmaRKHashRangePointwise(q, pat, j, m-1)
		assert reveal RKHashRange(q, j, j+m) == RKHashRange(q, j, j+m-1)*PrimeRK + uint32(q[j+m-1])
		assert reveal RKHashRange(pat, 0, m) == RKHashRange(pat, 0, m-1)*PrimeRK + uint32(pat[m-1])
		assert q[j+m-1] == pat[m-1]
	}
}

// lemmaRKHashRangeCongruence: if pat occurs in q at position j, then the
// hash of the corresponding range of q equals the hash of pat.
ghost
requires  0 <= j && j+len(pat) <= len(q)
requires  q[j:j+len(pat)] == pat
ensures   RKHashRange(q, j, j+len(pat)) == RKHashRange(pat, 0, len(pat))
decreases
func lemmaRKHashRangeCongruence(q, pat seq[byte], j int) {
	assert forall k int :: {q[j:j+len(pat)][k]} 0 <= k && k < len(pat) ==> q[j:j+len(pat)][k] == q[j+k]
	assert forall k int :: {q[j+k]} {pat[k]} 0 <= k && k < len(pat) ==> q[j+k] == pat[k]
	lemmaRKHashRangePointwise(q, pat, j, len(pat))
}

// lemmaMatchesAtTruePointwise introduces MatchesAt from a pointwise window
// match. The pointwise form is what callers want: it never mentions
// q[j:j+len(pat)], so no Seq_take/Seq_drop terms enter the caller's context.
ghost
requires  0 <= j && j+len(pat) <= len(q)
requires  forall m int :: {pat[m]} 0 <= m && m < len(pat) ==> q[j+m] == pat[m]
ensures   MatchesAt(q, pat, j)
decreases
func lemmaMatchesAtTruePointwise(q, pat seq[byte], j int) {
	lemmaMatchesAtRangeFromPointwise(q, pat, j, len(pat))
	assert reveal MatchesAt(q, pat, j)
}

// lemmaMatchesAtFalseWitness refutes MatchesAt from a window sequence w that
// agrees with q at position j but differs from pat. w is the sequence of the
// resliced window (seq(s[j:j+n])), which is a plain slice-to-seq term rather
// than a slice of a sequence, so this too keeps slicing out of the caller.
ghost
requires  0 <= j && j+len(pat) <= len(q)
requires  len(w) == len(pat)
requires  forall m int :: {pat[m]} 0 <= m && m < len(pat) ==> w[m] == q[j+m]
requires  w != pat
ensures   !MatchesAt(q, pat, j)
decreases
func lemmaMatchesAtFalseWitness(q, pat, w seq[byte], j int) {
	if reveal MatchesAt(q, pat, j) {
		lemmaMatchesAtRangePointwise(q, pat, j, len(pat))
		assert forall m int :: {pat[m]} 0 <= m && m < len(pat) ==> w[m] == pat[m]
		assert w == pat
		assert false
	}
}

// lemmaMatchesAtFalseNeq refutes MatchesAt from an established window
// mismatch.
ghost
requires  0 <= j && j+len(pat) <= len(q)
requires  q[j:j+len(pat)] != pat
ensures   !MatchesAt(q, pat, j)
decreases
func lemmaMatchesAtFalseNeq(q, pat seq[byte], j int) {
	if reveal MatchesAt(q, pat, j) {
		lemmaMatchesAtRangePointwise(q, pat, j, len(pat))
		assert len(q[j:j+len(pat)]) == len(pat)
		assert forall m int :: {pat[m]} 0 <= m && m < len(pat) ==>
			q[j:j+len(pat)][m] == q[j+m]
		assert forall m int :: {pat[m]} 0 <= m && m < len(pat) ==>
			q[j:j+len(pat)][m] == pat[m]
		assert q[j:j+len(pat)] == pat
		assert false
	}
}

// lemmaMatchesAtFalseHash refutes MatchesAt from a window-hash mismatch: if
// the pattern matched, the window hash would equal the pattern hash.
ghost
requires  0 <= j && j+len(pat) <= len(q)
requires  RKHashRange(q, j, j+len(pat)) != RKHashRange(pat, 0, len(pat))
ensures   !MatchesAt(q, pat, j)
decreases
func lemmaMatchesAtFalseHash(q, pat seq[byte], j int) {
	if q[j:j+len(pat)] == pat {
		lemmaRKHashRangeCongruence(q, pat, j)
	}
	lemmaMatchesAtFalseNeq(q, pat, j)
}

// lemmaNoMatchBeforeExtend extends a "no match before" prefix by one position.
ghost
requires  0 <= j && j+len(pat) <= len(q)
requires  NoMatchBefore(q, pat, j)
requires  !MatchesAt(q, pat, j)
ensures   NoMatchBefore(q, pat, j+1)
decreases
func lemmaNoMatchBeforeExtend(q, pat seq[byte], j int) {
	assert reveal NoMatchBefore(q, pat, j+1)
}

// lemmaMatchesAtFalseHashRange is lemmaMatchesAtFalseHash with the window
// given by its two endpoints instead of by j and len(pat). That is the shape
// IndexRabinKarpBytes needs: its rolling-hash invariant is stated over the
// window q[j:k], and going through len(pat) would leave the caller to prove
// j+len(pat) == k in a context where that step is not free.
ghost
requires  0 <= j && j <= k && k <= len(q) && len(pat) == k-j
requires  RKHashRange(q, j, k) != RKHashRange(pat, 0, k-j)
ensures   !MatchesAt(q, pat, j)
decreases
func lemmaMatchesAtFalseHashRange(q, pat seq[byte], j, k int) {
	lemmaMatchesAtFalseHash(q, pat, j)
}

// The two lemmas below are the interface between IndexRabinKarpBytes and the
// abstractions above. Both take the window of s as a pair of indices and hand
// back a fact about MatchesAt over seq(s) alone. Doing this in a lemma rather
// than inline in the search loop is what makes it go through: a lemma's proof
// context is exactly its precondition, whereas inline the same steps are
// attempted against everything the loop has accumulated by that point, and
// the window-equality step then exceeds the assert budget -- not for want of
// a fact, but for want of room.
//
// Both contracts carry the caller's address correspondence between s[lo:hi]
// and s (the ADDRESSES precondition below). It cannot be moved into the body,
// and it costs the caller nothing; see the note at its first occurrence.

// lemmaMatchesAtWindow: a window of s that equals pat is an occurrence of pat
// in s at the window's start.
ghost
requires  0 < p
requires  acc(s, p)
requires  0 <= lo && lo <= hi && hi <= len(s)
requires  len(pat) == hi-lo
// ADDRESSES. This has to be a precondition, not the first statement of the
// body: it is what makes the permission for the reslice -- and hence
// seq(s[lo:hi]) in the next clause -- available, and a contract is checked
// independently of the body it belongs to. Dropping it fails not on the
// assertion below but on the clause below it, with "Permission to
// seq(s[lo:hi]) might not suffice". It is free at the call site, which has to
// assert the same quantifier anyway for Equal(s[lo:hi], sep) to have
// permission. The second trigger is load-bearing too: the pointwise reasoning
// in the body mentions seq(s)[lo+m] and never &s[lo:hi][m], so under the
// address pattern alone this fact would sit in the context and never fire.
requires  forall k int :: {&s[lo:hi][k]} {seq(s)[lo+k]} 0 <= k && k < hi-lo ==> &s[lo:hi][k] == &s[lo+k]
requires  seq(s[lo:hi]) == pat
ensures   acc(s, p)
ensures   MatchesAt(seq(s), pat, lo)
decreases
func lemmaMatchesAtWindow(s []byte, pat seq[byte], lo, hi int, p perm) {
	assert forall m int :: {pat[m]} 0 <= m && m < len(pat) ==> seq(s)[lo+m] == pat[m]
	lemmaMatchesAtTruePointwise(seq(s), pat, lo)
}

// lemmaNoMatchExtendWindow: a window of s that the Rabin-Karp test rejects --
// either because its hash differs from the pattern's or because the byte
// comparison failed -- is not an occurrence, so the "no match before" prefix
// grows past it. The two ways the test can fail are refuted separately: the
// common one is arithmetic over RKHashRange alone, and only a hash collision
// has to look at the bytes.
ghost
requires  0 < p
requires  acc(s, p)
requires  0 <= lo && lo <= hi && hi <= len(s)
requires  len(pat) == hi-lo
requires  hash == RKHashRange(seq(s), lo, hi)
requires  NoMatchBefore(seq(s), pat, lo)
// ADDRESSES, as in lemmaMatchesAtWindow: needed for seq(s[lo:hi]) in the
// clause below to have permission.
requires  forall k int :: {&s[lo:hi][k]} {seq(s)[lo+k]} 0 <= k && k < hi-lo ==> &s[lo:hi][k] == &s[lo+k]
requires  hash != RKHashRange(pat, 0, hi-lo) || seq(s[lo:hi]) != pat
ensures   acc(s, p)
ensures   NoMatchBefore(seq(s), pat, lo+1)
decreases
func lemmaNoMatchExtendWindow(s []byte, pat seq[byte], lo, hi int, hash uint32, p perm) {
	if hash != RKHashRange(pat, 0, hi-lo) {
		lemmaMatchesAtFalseHashRange(seq(s), pat, lo, hi)
	} else {
		assert forall m int :: {pat[m]} 0 <= m && m < len(pat) ==> seq(s[lo:hi])[m] == seq(s)[lo+m]
		lemmaMatchesAtFalseWitness(seq(s), pat, seq(s[lo:hi]), lo)
	}
	lemmaNoMatchBeforeExtend(seq(s), pat, lo)
}

// lemmaRKHashStrDropFirst is the string counterpart of
// lemmaRKHashRangeDropFirst:
//   RKHashStr(s, lo, hi) == s[lo]*PrimeRK^(hi-lo-1) + RKHashStr(s, lo+1, hi).
ghost
requires  0 <= lo && lo < hi && hi <= len(s)
ensures   RKHashStr(s, lo, hi) == PowRK(PrimeRK, hi-lo-1)*uint32(s[lo]) + RKHashStr(s, lo+1, hi)
decreases hi - lo
func lemmaRKHashStrDropFirst(s string, lo, hi int) {
	lemmaRKHashStrStep(s, lo, hi)
	if lo+1 == hi {
		lemmaPowRKOneMul(uint32(s[lo]), hi-lo-1)
	} else {
		lemmaRKHashStrDropFirst(s, lo, hi-1)
		lemmaRKHashStrStep(s, lo+1, hi)
		lemmaPowRKHornerStep(uint32(s[lo]), RKHashStr(s, lo+1, hi-1), uint32(s[hi-1]), RKHashStr(s, lo, hi-1), hi-lo-2, hi-lo-1)
	}
}

// lemmaRKHashStrRoll is the string counterpart of lemmaRKHashRangeRoll: the
// rolling-hash update step over a range of a string.
ghost
requires  0 < n && n <= i && i < len(s)
ensures   RKHashStr(s, i-n+1, i+1) == RKHashStr(s, i-n, i)*PrimeRK + uint32(s[i]) - PowRK(PrimeRK, n)*uint32(s[i-n])
decreases
func lemmaRKHashStrRoll(s string, n, i int) {
	lemmaRKHashStrDropFirst(s, i-n, i)
	lemmaRKHashStrStep(s, i-n+1, i+1)
	lemmaPowRKHornerStep(uint32(s[i-n]), RKHashStr(s, i-n+1, i), uint32(s[i]), RKHashStr(s, i-n, i), n-1, n)
}

