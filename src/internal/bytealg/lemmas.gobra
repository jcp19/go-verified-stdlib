// Enables Gobra in the current file.
// +gobra

// This file holds the lemmas of package bytealg: ghost functions whose only
// purpose is to establish a fact about the abstractions defined in
// spec.gobra. They carry no permissions and are erased at compile time.
//
// Lemmas live here rather than in spec.gobra so that the specification -- the
// definitions a reader must understand to read the contracts -- stays separate
// from the proofs that discharge them.

package bytealg

// lemmaMatchesAtRangeFromPointwise: pointwise equality of the window with the
// pattern establishes MatchesAtRange. The trigger pat[m] contains no
// arithmetic, so it is a valid SMT pattern (unlike q[j+m]).
ghost
requires 0 <= j && 0 <= k && k <= len(pat) && j+k <= len(q)
requires forall m int :: {pat[m]} 0 <= m && m < k ==> q[j+m] == pat[m]
ensures MatchesAtRange(q, pat, j, k)
decreases k
func lemmaMatchesAtRangeFromPointwise(q, pat seq[byte], j, k int) {
	if k > 0 {
		lemmaMatchesAtRangeFromPointwise(q, pat, j, k-1)
	}
}

// lemmaMatchesAtRangePointwise: the converse, used to refute a match from a
// single mismatching position.
ghost
requires 0 <= j && 0 <= k && k <= len(pat) && j+k <= len(q)
requires MatchesAtRange(q, pat, j, k)
ensures forall m int :: {pat[m]} 0 <= m && m < k ==> q[j+m] == pat[m]
decreases k
func lemmaMatchesAtRangePointwise(q, pat seq[byte], j, k int) {
	if k > 0 {
		lemmaMatchesAtRangePointwise(q, pat, j, k-1)
	}
}

// lemmaNoMatchBeforeZero: the empty prefix trivially contains no match.
ghost
requires len(pat) <= len(q)+1
ensures NoMatchBefore(q, pat, 0)
decreases
func lemmaNoMatchBeforeZero(q, pat seq[byte]) {
	assert reveal NoMatchBefore(q, pat, 0)
}

// LemmaNoMatchBeforePointwise lets clients turn NoMatchBefore into the
// pointwise form.
ghost
requires 0 <= hi && hi-1+len(pat) <= len(q)
requires NoMatchBefore(q, pat, hi)
ensures forall j int :: {MatchesAt(q, pat, j)} 0 <= j && j < hi ==> !MatchesAt(q, pat, j)
decreases hi
func LemmaNoMatchBeforePointwise(q, pat seq[byte], hi int) {
	if hi > 0 {
		assert reveal NoMatchBefore(q, pat, hi)
		LemmaNoMatchBeforePointwise(q, pat, hi-1)
	}
}

// lemmaMulComm3 is a commutativity helper for products of three factors.
// Proving this rearrangement inline in a context with many quantified facts
// makes Z3 struggle; as an isolated lemma it is immediate.
ghost
ensures x*y*z == x*z*y
decreases
func lemmaMulComm3(x, y, z uint32) {}

// lemmaPowRKEven: b^(2k) == (b*b)^k.
ghost
requires 0 <= k
ensures PowRK(b, 2*k) == PowRK(b*b, k)
decreases k
func lemmaPowRKEven(b uint32, k int) {
	if k != 0 {
		lemmaPowRKEven(b, k-1)
		assert PowRK(b, 2*k) == PowRK(b, 2*k-1)*b
		assert PowRK(b, 2*k-1) == PowRK(b, 2*k-2)*b
		assert PowRK(b*b, k) == PowRK(b*b, k-1)*(b*b)
	}
}

// lemmaPowRKOdd: b^(2k+1) == (b*b)^k * b.
ghost
requires 0 <= k
ensures PowRK(b, 2*k+1) == PowRK(b*b, k)*b
decreases
func lemmaPowRKOdd(b uint32, k int) {
	lemmaPowRKEven(b, k)
	assert PowRK(b, 2*k+1) == PowRK(b, 2*k)*b
}

// lemmaRKHashRangeDropFirst peels the first byte off a range hash:
//   RKHashRange(q, lo, hi) == q[lo]*PrimeRK^(hi-lo-1) + RKHashRange(q, lo+1, hi).
ghost
requires 0 <= lo && lo < hi && hi <= len(q)
ensures RKHashRange(q, lo, hi) == PowRK(PrimeRK, hi-lo-1)*uint32(q[lo]) + RKHashRange(q, lo+1, hi)
decreases hi - lo
func lemmaRKHashRangeDropFirst(q seq[byte], lo, hi int) {
	if lo+1 == hi {
		assert RKHashRange(q, lo, hi) == RKHashRange(q, lo, hi-1)*PrimeRK + uint32(q[hi-1])
	} else {
		lemmaRKHashRangeDropFirst(q, lo, hi-1)
		assert RKHashRange(q, lo, hi) == RKHashRange(q, lo, hi-1)*PrimeRK + uint32(q[hi-1])
		assert RKHashRange(q, lo+1, hi) == RKHashRange(q, lo+1, hi-1)*PrimeRK + uint32(q[hi-1])
		assert PowRK(PrimeRK, hi-lo-1) == PowRK(PrimeRK, hi-lo-2)*PrimeRK
		lemmaMulComm3(PowRK(PrimeRK, hi-lo-2), uint32(q[lo]), PrimeRK)
	}
}

// lemmaRKHashRangeRoll is the rolling-hash update step of Rabin-Karp: sliding
// the window q[i-n:i] one position to the right multiplies the hash by
// PrimeRK, adds the new last byte, and removes the contribution
// PrimeRK^n * q[i-n] of the dropped byte.
ghost
requires 0 < n && n <= i && i < len(q)
ensures RKHashRange(q, i-n+1, i+1) == RKHashRange(q, i-n, i)*PrimeRK + uint32(q[i]) - PowRK(PrimeRK, n)*uint32(q[i-n])
decreases
func lemmaRKHashRangeRoll(q seq[byte], n, i int) {
	lemmaRKHashRangeDropFirst(q, i-n, i)
	assert RKHashRange(q, i-n+1, i+1) == RKHashRange(q, i-n+1, i)*PrimeRK + uint32(q[i])
	assert PowRK(PrimeRK, n) == PowRK(PrimeRK, n-1)*PrimeRK
	lemmaMulComm3(PowRK(PrimeRK, n-1), uint32(q[i-n]), PrimeRK)
}

// lemmaRKHashRangePointwise: ranges that agree pointwise hash equally.
ghost
requires 0 <= j && 0 <= m && m <= len(pat) && j+m <= len(q)
requires forall k int :: {q[j+k]} {pat[k]} 0 <= k && k < m ==> q[j+k] == pat[k]
ensures RKHashRange(q, j, j+m) == RKHashRange(pat, 0, m)
decreases m
func lemmaRKHashRangePointwise(q, pat seq[byte], j, m int) {
	if m > 0 {
		lemmaRKHashRangePointwise(q, pat, j, m-1)
		assert RKHashRange(q, j, j+m) == RKHashRange(q, j, j+m-1)*PrimeRK + uint32(q[j+m-1])
		assert RKHashRange(pat, 0, m) == RKHashRange(pat, 0, m-1)*PrimeRK + uint32(pat[m-1])
		assert q[j+m-1] == pat[m-1]
	}
}

// lemmaRKHashRangeCongruence: if pat occurs in q at position j, then the
// hash of the corresponding range of q equals the hash of pat.
ghost
requires 0 <= j && j+len(pat) <= len(q)
requires q[j:j+len(pat)] == pat
ensures RKHashRange(q, j, j+len(pat)) == RKHashRange(pat, 0, len(pat))
decreases
func lemmaRKHashRangeCongruence(q, pat seq[byte], j int) {
	assert forall k int :: {q[j:j+len(pat)][k]} 0 <= k && k < len(pat) ==> q[j:j+len(pat)][k] == q[j+k]
	assert forall k int :: {q[j+k]} {pat[k]} 0 <= k && k < len(pat) ==> q[j+k] == pat[k]
	lemmaRKHashRangePointwise(q, pat, j, len(pat))
}

// lemmaMatchesAtTrue introduces MatchesAt from an established window match.
ghost
requires 0 <= j && j+len(pat) <= len(q)
requires q[j:j+len(pat)] == pat
ensures MatchesAt(q, pat, j)
decreases
func lemmaMatchesAtTrue(q, pat seq[byte], j int) {
	assert forall m int :: {pat[m]} 0 <= m && m < len(pat) ==>
		q[j+m] == q[j:j+len(pat)][m]
	assert forall m int :: {pat[m]} 0 <= m && m < len(pat) ==> q[j+m] == pat[m]
	lemmaMatchesAtRangeFromPointwise(q, pat, j, len(pat))
	assert reveal MatchesAt(q, pat, j)
}

// lemmaMatchesAtTruePointwise introduces MatchesAt from a pointwise window
// match. Callers prefer this over lemmaMatchesAtTrue: it never mentions
// q[j:j+len(pat)], so no Seq_take/Seq_drop terms enter the caller's context.
ghost
requires 0 <= j && j+len(pat) <= len(q)
requires forall m int :: {pat[m]} 0 <= m && m < len(pat) ==> q[j+m] == pat[m]
ensures MatchesAt(q, pat, j)
decreases
func lemmaMatchesAtTruePointwise(q, pat seq[byte], j int) {
	lemmaMatchesAtRangeFromPointwise(q, pat, j, len(pat))
	assert reveal MatchesAt(q, pat, j)
}

// lemmaMatchesAtFalseWitness refutes MatchesAt from a window sequence w that
// agrees with q at position j but differs from pat. w is the sequence of the
// resliced window (seq(s[j:j+n])), which is a plain slice-to-seq term rather
// than a slice of a sequence, so this too keeps slicing out of the caller.
ghost
requires 0 <= j && j+len(pat) <= len(q)
requires len(w) == len(pat)
requires forall m int :: {pat[m]} 0 <= m && m < len(pat) ==> w[m] == q[j+m]
requires w != pat
ensures !MatchesAt(q, pat, j)
decreases
func lemmaMatchesAtFalseWitness(q, pat, w seq[byte], j int) {
	if reveal MatchesAt(q, pat, j) {
		lemmaMatchesAtRangePointwise(q, pat, j, len(pat))
		assert forall m int :: {pat[m]} 0 <= m && m < len(pat) ==> w[m] == pat[m]
		assert w == pat
		assert false
	}
}

// lemmaMatchesAtFalseNeq refutes MatchesAt from an established window
// mismatch.
ghost
requires 0 <= j && j+len(pat) <= len(q)
requires q[j:j+len(pat)] != pat
ensures !MatchesAt(q, pat, j)
decreases
func lemmaMatchesAtFalseNeq(q, pat seq[byte], j int) {
	if reveal MatchesAt(q, pat, j) {
		lemmaMatchesAtRangePointwise(q, pat, j, len(pat))
		assert len(q[j:j+len(pat)]) == len(pat)
		assert forall m int :: {pat[m]} 0 <= m && m < len(pat) ==>
			q[j:j+len(pat)][m] == q[j+m]
		assert forall m int :: {pat[m]} 0 <= m && m < len(pat) ==>
			q[j:j+len(pat)][m] == pat[m]
		assert q[j:j+len(pat)] == pat
		assert false
	}
}

// lemmaMatchesAtFalseHash refutes MatchesAt from a window-hash mismatch: if
// the pattern matched, the window hash would equal the pattern hash.
ghost
requires 0 <= j && j+len(pat) <= len(q)
requires RKHashRange(q, j, j+len(pat)) != RKHashRange(pat, 0, len(pat))
ensures !MatchesAt(q, pat, j)
decreases
func lemmaMatchesAtFalseHash(q, pat seq[byte], j int) {
	if q[j:j+len(pat)] == pat {
		lemmaRKHashRangeCongruence(q, pat, j)
	}
	lemmaMatchesAtFalseNeq(q, pat, j)
}

// lemmaRKHashStrDropFirst is the string counterpart of
// lemmaRKHashRangeDropFirst:
//   RKHashStr(s, lo, hi) == s[lo]*PrimeRK^(hi-lo-1) + RKHashStr(s, lo+1, hi).
ghost
requires 0 <= lo && lo < hi && hi <= len(s)
ensures RKHashStr(s, lo, hi) == PowRK(PrimeRK, hi-lo-1)*uint32(s[lo]) + RKHashStr(s, lo+1, hi)
decreases hi - lo
func lemmaRKHashStrDropFirst(s string, lo, hi int) {
	if lo+1 == hi {
		assert RKHashStr(s, lo, hi) == RKHashStr(s, lo, hi-1)*PrimeRK + uint32(s[hi-1])
	} else {
		lemmaRKHashStrDropFirst(s, lo, hi-1)
		assert RKHashStr(s, lo, hi) == RKHashStr(s, lo, hi-1)*PrimeRK + uint32(s[hi-1])
		assert RKHashStr(s, lo+1, hi) == RKHashStr(s, lo+1, hi-1)*PrimeRK + uint32(s[hi-1])
		assert PowRK(PrimeRK, hi-lo-1) == PowRK(PrimeRK, hi-lo-2)*PrimeRK
	}
}
