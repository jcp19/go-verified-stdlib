// Enables Gobra in the current file.
// +gobra

package sync

// Lemmas about the bit layout of Mutex.state. Both are *proved*; the axiom they
// rest on is bitsLemma in assumptions.gobra.

// decompUnique states that the decomposition of a state word is unique. Unlike
// bitsLemma it is *proved*: it is plain linear arithmetic.
ghost
requires 0 <= l1 && l1 <= 1 && 0 <= w1 && w1 <= 1 && 0 <= s1 && s1 <= 1 && 0 <= n1
requires 0 <= l2 && l2 <= 1 && 0 <= w2 && w2 <= 1 && 0 <= s2 && s2 <= 1 && 0 <= n2
requires l1 + 2*w1 + 4*s1 + 8*n1 == l2 + 2*w2 + 4*s2 + 8*n2
ensures  l1 == l2 && w1 == w2 && s1 == s2 && n1 == n2
decreases
func decompUnique(l1 int32, w1 int32, s1 int32, n1 int32, l2 int32, w2 int32, s2 int32, n2 int32) {
}

// bitsOf is the workhorse: from the decomposition of one state word `s` and a
// second word `t` known to have a given decomposition, it derives every bit
// fact about `t`. It is proved from bitsLemma and decompUnique.
ghost
requires 0 <= t
requires 0 <= l && l <= 1 && 0 <= w && w <= 1 && 0 <= st && st <= 1 && 0 <= n
requires t == l + 2*w + 4*st + 8*n
ensures  bitLocked(t) == l && bitWoken(t) == w && bitStarving(t) == st && numWaiters(t) == n
ensures  t & mutexLocked == l
ensures  t & mutexWoken == 2*w
ensures  t & mutexStarving == 4*st
ensures  t & (mutexLocked|mutexWoken) == l + 2*w
ensures  t & (mutexLocked|mutexStarving) == l + 4*st
ensures  t & (mutexLocked|mutexWoken|mutexStarving) == l + 2*w + 4*st
ensures  t >> mutexWaiterShift == n
ensures  t | mutexLocked == 1 + 2*w + 4*st + 8*n
ensures  t | mutexWoken == l + 2 + 4*st + 8*n
ensures  t | mutexStarving == l + 2*w + 4 + 8*n
ensures  t &^ mutexWoken == l + 4*st + 8*n
ensures  1 << mutexWaiterShift == 8
decreases
func bitsOf(t int32, l int32, w int32, st int32, n int32) {
	bitsLemma(t)
	decompUnique(bitLocked(t), bitWoken(t), bitStarving(t), numWaiters(t), l, w, st, n)
}

