// Enables Gobra in the current file.
// +gobra

// This file holds a Gobra stub for the special package unsafe. It declares
// only the members needed by the packages under verification.

package unsafe

// Offsetof returns the offset within the struct of the field represented by x,
// which must be of the form structValue.field.
decreases
pure func Offsetof(x bool) uintptr
